book_url = "https://www.gutenberg.org/cache/epub/1661/pg1661.txt"
llm_model = "gemma3:latest"

logic.simple_english_translation(paragraph_text) {
  let prompt = (please rewrite the content of <paragraph> to a new version that uses only modern and very very simple english words and sentences. USE Sentence Combining AND Clause Linking AS YOU SEE FIT. DO NOT MISS ANY DEEP DETAILS,DEEP MEANINGS AND TONES OF THE ORIGINAL VERSION. NO EXPLANATION, NO EXTRA WORDS, DO NOT RETURN CHINESE CHARACTERS, <paragraph>{paragraph_text}</paragraph>)
  return prompt
}

logic.highlighted_text_in_popup_modal(text, popup_modal) {
  let context = (30 words before {text}) + {text} + (30 words after {text})
  let question = string {
    context: {context}
    show me the pronounciation of {text} in International Phonetic Alphabet
    show the meaning of {text} in 30 words, translate {the meaning of {text}} in simplified chinese
    no extra words
  }
  let result = (send a request to index.php?q={question})
  display {result} in {popup_modal} with veritcal scrolling
  when we have index.php?q={question} {
    send request to ollma server 127.0.0.1:11434 with model: {llm_model}, query: {question}
    return the response as string and print it out
    do php exit
  }
  stream the result so that the first chunk will show immediately in {popup_modal}
}

app_spec {
  app_type: Pure HTML/CSS/Javascript Single Page Application
  app_entrypoint: index.php

  let book_content = (use php to read the file content from {book_url})

  div.book_content.innerHTML = {book_content}

  logic.highlighted_text_in_popup_modal(highlighted text in {book_content}, a popup modal)
}

