// ============================================================
// Book Reader - Spec-Driven Development (Single Source of Truth)
// ============================================================

// --- Configuration ---

config {
  book_url = "https://www.gutenberg.org/cache/epub/1661/pg1661.txt"
  llm_model = "gemma3:latest"
  llm_thinking_mode = false
}

config.servers {
  php_web_server {
    host: "127.0.0.1"
    port: 3000
    workers: 4
    entrypoint: "index.php"
  }

  ollama {
    host: "127.0.0.1"
    port: 11434
    model: {config.llm_model}
  }

  tts {
    host: "127.0.0.1"
    port: 4000
    engine: "edge-tts"
    runtime: "python3.11"
    framework: "flask"
    default_voice: "en-US-AndrewNeural"
    cors: true
  }
}

// --- Logic Layer ---

logic.simple_english_translation(paragraph_text) {
  let prompt = (<paragraph>{paragraph_text}</paragraph>, please rewrite the <paragraph> to a new paragraph <new_pragraph>, Use VERY SIMPLE ENGLISH WORDS. ALWAYS USE Sentence Combining AND Clause. DO NOT MISS ANY DEEP DETAILS, DEEP MEANINGS AND TONES OF THE ORIGINAL PARAGRAPH. RETURN THE CONTENT OF <new_pragraph> ONLY, NO EXPLANATION, NO EXTRA WORDS, DO NOT SHOW WHAT YOU DID, JUST SHOW THE PURE CONTENT OF <new_pragraph>)
  return prompt
}

logic.perform_simple_english_translation(paragraph_text) {
  let prompt = logic.simple_english_translation(paragraph_text)
  let response = send request to ollma server 127.0.0.1:11434 with model: {config.llm_model}, query: {prompt}, thinking: {config.llm_thinking_mode}
  return response
}


logic.highlighted_text_in_popup_modal(text, popup_modal) {
  let context = (30 words before {text}) + {text} + (30 words after {text})
  let question = string {
    context: {context}
    show me the pronounciation of {text} in International Phonetic Alphabet
    show the meaning of {text} in 30 words, translate {the meaning of {text}} in simplified chinese
    no extra words
  }
  let result = (send a request to index.php?q={question})
  display {result} in {popup_modal} with vertical scrolling
  when we have index.php?q={question} {
    send request to {config.servers.ollama} with model: {config.llm_model}, query: {question}
    return the response as string and print it out
    do php exit
  }
  stream the result so that the first chunk will show immediately in {popup_modal}
}

logic.llm_response_filter {
  description: "Filter out LLM meta-commentary from responses"
  filters [
    remove sentences starting with "Let me know if"
    remove sentences starting with "Here's the rewritten paragraph" (case-insensitive)
    remove sentences starting with "Here is the rewritten paragraph" (case-insensitive)
    remove sentences like "Please provide the paragraph you would like me to rewrite..."
    remove sentences like "Please let me know if you'd like help with any other text!"
    remove sentences ending with a smiling emoji
    remove <think> blocks from LLM responses
  ]
}

logic.book_summarization(book_content) {
  description: "Map-Reduce summarization of book content"
  map {
    split {book_content} into chunks of 300 words each
    for each {chunk} {
      let mini_summary = (send request to {config.servers.ollama} with model: {config.llm_model}, query: "summarize this: {chunk}")
    }
  }
  reduce {
    let combined = (all mini_summaries joined together)
    let final_summary = (send request to {config.servers.ollama} with model: {config.llm_model}, query: "create a 300 word summary from: {combined}")
    return final_summary
  }
  cache: "./cache/pg{book_id}/summary.txt"
}

// --- Model Layer ---

model.book {
  properties {
    url: string          // gutenberg URL
    book_id: string      // extracted from URL, e.g. "1661"
    name: string         // title of the book
    content: string      // raw text content fetched via PHP
    paragraphs: []model.paragraph
  }

  load(url) {
    let content = (use php to read the file content from {url})
    split {content} into {paragraphs}
    for each {paragraph} in {paragraphs} where length > 20 chars {
      check cache for existing translation
      if cached (p_{index}_progress.txt contains "100") {
        load from p_{index}_simplified.txt
      } else {
        let prompt = logic.simple_english_translation({paragraph})
        let response = (send request to {config.servers.ollama} with model: {config.llm_model}, query: {prompt})
        apply logic.llm_response_filter to {response}
        cache {response} to p_{index}_simplified.txt
        write "100" to p_{index}_progress.txt
      }
      stream {response} to div.id:"book_content" in real-time
    }
  }
}

model.paragraph {
  properties {
    index: int                // paragraph offset in the book
    original_text: string     // original text before translation
    simplified_text: string   // simple english version
    original_cache_path: string  // "./cache/pg{book_id}/p_{index}_original.txt"
    cache_path: string        // "./cache/pg{book_id}/p_{index}_simplified.txt"
    progress_path: string     // "./cache/pg{book_id}/p_{index}_progress.txt"
  }
}

model.history {
  file: "history.txt"
  format: "{book_name}|{url}" // one entry per line
  gitignore: true

  save(book_name, url) {
    prepend "{book_name}|{url}" to history.txt
  }

  load() {
    return first line's URL from history.txt as default book
  }

  get_top(n = 10) {
    return top {n} entries from history.txt
  }
}

model.cache {
  base_dir: "./cache"
  gitignore: true

  structure {
    ./cache/pg{book_id}/
      p_{paragraph_offset}_original.txt      // original paragraph text before translation
      p_{paragraph_offset}_simplified.txt    // translated paragraph text
      p_{paragraph_offset}_progress.txt      // "100" when fully translated, "0" when in progress
      summary.txt                            // book summary (from map-reduce)
  }
}

// --- API Layer (PHP Backend) ---

api {
  entrypoint: "index.php"
  php_max_execution_time: unlimited  // no 30-second timeout

  endpoint.query {
    route: "?q={question}"
    method: GET, POST
    behavior {
      send {question} to {config.servers.ollama}
      stream response back to client
      apply logic.llm_response_filter
      php exit after response
    }
  }

  endpoint.stream_book {
    route: "?stream_book&url={url}"
    method: GET
    behavior {
      fetch book from {url}
      split into paragraphs
      for each paragraph > 20 chars {
        check model.cache for existing translation
        if not cached, translate via {config.servers.ollama}
        stream JSON events to client: { type: "paragraph", text: "...", index: N }
        cache result to model.cache
      }
    }
  }

  endpoint.summarize_book {
    route: "?summarize_book&url={url}"
    method: GET
    behavior {
      invoke logic.book_summarization(book_content)
      stream result to client
      cache to ./cache/pg{book_id}/summary.txt
    }
  }

  endpoint.save_url {
    route: "?save_url={url}&name={book_name}"
    method: GET
    behavior {
      invoke model.history.save({book_name}, {url})
    }
  }

  endpoint.get_history {
    route: "?get_history"
    method: GET
    behavior {
      return JSON array of model.history entries
    }
  }

  endpoint.fetch_url {
    route: "?url={url}"
    method: GET
    behavior {
      fetch remote content from {url}
      return raw content
    }
  }
}

// --- TTS Server (Python Backend) ---

tts_server {
  file: "tts_server.py"
  host: {config.servers.tts.host}
  port: {config.servers.tts.port}

  endpoint.tts {
    route: "/tts"
    method: GET, POST
    params {
      text: string          // text to speak
      voice: string         // default: "en-US-AndrewNeural"
      rate: string          // speech rate adjustment (optional)
    }
    behavior {
      convert {text} to speech using edge-tts
      stream audio as "audio/mpeg"
      reuse event loop for efficiency
    }
  }

  voice_profile {
    gender: male
    engine: "en-US-AndrewNeural"
    requirement: natural, not robotic, sounds like a human
    speed: moderate (news reporter pace, slightly adjusted slower)
    streaming: sentence-by-sentence (split on "." not newline)
  }
}

// --- UI Layer ---

ui {
  app_type: "Pure HTML/CSS/Javascript Single Page Application"
  rendering: markdown support in div.id:"book_content"
}

ui.toolbar {
  layout: horizontal bar at top

  element.url_input {
    id: "url-input"
    type: input textbox
    behavior {
      on_enter(url) {
        save to model.history
        load book from {url}
      }
      on_page_load {
        auto-load URL from first line of history.txt
      }
    }
  }

  element.history_button {
    id: "history-btn"
    type: button (down arrow icon)
    position: next to {ui.toolbar.element.url_input}
    behavior {
      @click {
        show dropdown under {ui.toolbar.element.url_input}
        display top 10 book names from model.history
        style {
          font-color: black
          font-weight: normal (not bold)
          font-size: 14px
        }
        on_select(book) {
          load the selected book's URL
        }
      }
    }
  }

  element.highlight_label {
    text: "Highlight text to look up"
  }

  element.summarize_button {
    position: next to {ui.toolbar.element.highlight_label}
    text: "Summarize"
    behavior {
      @click {
        invoke logic.book_summarization(original book content)
        display final summary
      }
    }
  }
}

ui.book_content {
  id: "book_content"
  type: div
  rendering: markdown

  behavior {
    on_text_highlight(selected_text) {
      invoke logic.highlighted_text_in_popup_modal({selected_text}, new popup_modal)
    }
  }
}

ui.paragraph_controls {
  description: "Controls displayed on the right side of each paragraph"

  element.voice_button {
    position: right side of each paragraph
    icon: speaker/voice icon
    behavior {
      @click {
        send paragraph text to {tts_server} sentence-by-sentence
        stream audio playback immediately per sentence
        split sentences on "." (not newline)
      }
    }
  }

  element.original_text_button {
    text: "Original Text"
    position: right of {ui.paragraph_controls.element.voice_button}
    behavior {
      @click {
        show popup_modal with the original text before simple english conversion
      }
    }
  }

  element.ask_question_button {
    text: "Ask Question"
    position: right of {ui.paragraph_controls.element.original_text_button}
    behavior {
      @click {
        show popup_modal with textbox
        on_enter(question) {
          let context = (current paragraph + previous 20 paragraphs + next 20 paragraphs)
          let answer = (send request to {config.servers.ollama} with model: {config.llm_model}, query: {question}, context: {context})
          display {answer} below the question textbox
        }
      }
    }
  }

  element.simplify_again_button {
    text: "Simplify Again"
    position: right of {ui.paragraph_controls.element.ask_question_button}
    behavior {
      @click {
        invoke logic.perform_simple_english_translation(paragraph_text)
        replace paragraph text in-place with the new simplified result
        stream response with loading indicator
      }
    }
  }
}

ui.popup_modal {
  description: "Shared popup modal behavior for all modals"

  properties {
    draggable: true
    remember_position: true  // saves last known location, reopens there
    background_dim: false    // do NOT gray out the background
    vertical_scrolling: true
  }

  word_lookup_modal extends ui.popup_modal {
    content {
      pronunciation: IPA format
      voice_icon {
        position: next to IPA pronunciation
        @click {
          use natural english TTS to speak the pronunciation
          DO NOT trigger another popup, only play voice
        }
      }
      meaning: 30 word definition in english
      chinese_translation: meaning translated to simplified chinese
    }
  }

  simple_english_modal extends ui.popup_modal {
    content {
      simplified_text: string  // the simple english conversion result
      voice_button {
        @click {
          read content using natural TTS via {tts_server}
        }
      }
    }
    on_open {
      highlight the related paragraph in book_content
    }
  }

  question_modal extends ui.popup_modal {
    content {
      question_textbox: input
      answer_display: div below question_textbox
    }
  }
}

// --- Startup Script ---

startup {
  file: "./start.sh"
  behavior {
    for each service in [php_web_server, ollama, tts_server] {
      if existing process is running on the service's port {
        kill it
      }
      start new instance
    }
    trap Ctrl+C to cleanly shutdown all services
  }
}

// --- App Spec (Main Entry Point) ---

app_spec {
  app_type: {ui.app_type}
  app_entrypoint: {api.entrypoint}

  on_load {
    let url = model.history.load()  // get last book URL from history
    invoke model.book.load({url})   // stream + translate paragraphs
    render to {ui.book_content} with markdown
    attach {ui.paragraph_controls} to each paragraph
    enable {ui.book_content.behavior.on_text_highlight}
  }
}

// --- Directive ---

{
  update ./spec.prompt after completing each task
}
