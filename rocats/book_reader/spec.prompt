task.streaming_the_simple_translation {
  action (completed) {
    - remove all the "Simple English" buttons in each paragraph
    - when a book is loaded {
      let paragraphs = (get all pragraphs of the book)
      for each {paragraph} in {pragraphs} {
        let prompt = invoke logic.simple_english_translation({paragraph})
        let response = send request to ollma server 127.0.0.1:11434 with model: {llm_model}, query: {prompt}
        append {response} in a streaming fashion in div.id:"book_content"
      }
    }
  }
}

