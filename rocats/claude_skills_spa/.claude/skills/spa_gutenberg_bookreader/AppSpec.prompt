class AppSpec extends BaseAppSpec {
  init() {
    constraint {
      there should be only one single php file, {app_entrypoint}, no other php files should be generated
    }

    div.book_content.style.background: "wheat"

    layout {
      div.style {
        background: BurlyWood
      } {
        {textbox.book_url}
      }
      div {
        {book_content} 
      }
    }

    div.book_content.paragraphs.each (paragraph) {
      next to {paragraph} add:
      - SimpleEnglishConversionButton {
        behavior: show when {paragraph} is visible
        params: paragraph.text
      }
    }
  }
}
