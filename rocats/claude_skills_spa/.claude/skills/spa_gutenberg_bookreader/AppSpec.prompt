class AppSpec {
  book_url = ""
  llm_model = "gemma3:latest"
  app_entrypoint: index.php

  highlighted_text_in_popup_modal(text, popup_modal) {
    let context = (30 words before {text}) + {text} + (30 words after {text})
    let question = string {
      context: {context}
      show me the pronounciation of {text} in International Phonetic Alphabet
      show the meaning of {text} in 30 words, translate {the meaning of {text}} in simplified chinese
      no extra words
    }
    let result = (send a request to index.php?q={question})
    display {result} in {popup_modal} with veritcal scrolling
    when we have index.php?q={question} {
      send request to ollma server 127.0.0.1:11434 with model: {llm_model}, query: {question}
      return the response as string and print it out
      do php exit
    }
    stream the result so that the first chunk will show immediately in {popup_modal}
  }

  init() {
    if (app_entrypoint exists) {
      return
    }

    textbox.book_url {
      value = ""
      @key.enter {
        let book_url = value
        let book_content = (use php to read the file content from {book_url})
      }
    }
    div.book_content {
      style {
        line-height: 1.4
      }
      innerHTML: {book_content}
    }
    
    modal.highlighted_words_translation {
      behavior {
        draggable
        remember the last position
      }  
    }
    highlighted_text_in_popup_modal(highlighted text in {book_content}, modal.highlighted_words_translation)
  }
}
