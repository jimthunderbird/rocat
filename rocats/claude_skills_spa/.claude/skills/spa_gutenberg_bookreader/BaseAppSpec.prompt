class BaseAppSpec {
  app_entrypoint: index.php {
    coding_style: ./knowledge/php_page_style.md
  }

  highlighted_text_in_popup_modal(text, popup_modal) {
    let context = (30 words before {text}) + {text} + (30 words after {text})
    let question = string {
      in the context: {context}, show the meaning of {text} using very simple English words 
      no explanation, no extra words
    }
    let result = Config.local_llm(question) 
    display {result} in {popup_modal} with veritcal scrolling
  }

  textbox.book_url {
    value = ""
    @load {
      read the very last entry from local storage key "book_history"
      create key.enter event
    }
    @key.enter {
      book_content = "Loading..."
      let book_url = value
      append {book_url} to local storage key "book_history", make sure all entries in "book_history" are unqiue!
      let book_content = (use php to read the file content from {book_url}, make sure it returns only the pure content)
    }
  }

  div.book_content {
    behavior {
      before the {book_content} is loaded into it, the inner html should be completely empty
      after {book_content} is loaded, the inner html should contain only pure text, it should not have any html tags
      split {book_content} into html paragraphs
    }
    style {
      line-height: 1.4
    }
    innerHTML: {book_content}
  }

  modal.highlighted_words_translation(highlighted_text) extends SimpleModal {
    behavior {
      when visible, invoke highlighted_text_in_popup_modal({highlighted_text}, modal.highlighted_words_translation)
    }  
  }
}
