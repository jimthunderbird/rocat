class SimpleEnglishConversionButton
{
  parameter {
    text_to_convert
  }

  text {
    "Convert To Simple English"  
  }

  @click {
    let prompt = (
      given <text>{text_to_convert}</text>, convert it to a version that use very simple English words, show me the converted result only, no explanation, no extra words
    )
    result = send prompt to Config.local_llm()
    show model.simple_english_displayer extends SimpleModal {
      content: result
      style {
        background: wheat
      }
    }
  }  
}
