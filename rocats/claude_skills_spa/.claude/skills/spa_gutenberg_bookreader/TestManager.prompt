class TestManager
{
  run() {
    let code_check_items = (
    - think hard and thoroughly on AppSpec, examine {AppSpec.app_entrypoint}, return a list of check items that we need to make sure all requirements in the AppSpec are met
    )

    run the list of {code_check_items}, if any one of the item does not pass, return false, if they all passed, return true 
  }
}
