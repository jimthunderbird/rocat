class TestManager
{
  create_code_check_list_items() {
    let items = (
    - think hard and thoroughly on AppSpec, examine {AppSpec.app_entrypoint}, return a very detail list of check items that we need to make sure all requirements in the AppSpec are met
    )
    save {items} to ./code_check_items.txt
  }

  create_e2e_check_list_items() {
    let items = (
    - think hard and thoroughly on AppSpec, examine {BaseAppSpec.app_entrypoint}, return a very detail list of check items that we need to perform E2E testing with puppeteer
    )
    save {items} to ./e2e_check_items.txt
  }

  run() {
    (if ./code_check_items.txt does not exist yet) or (do a git status check, if any one of the .prompt files are changed) {
      create_code_check_list_items()
    }

    (if ./e2e_check_items.txt does not exist yet) or (do a git status check, if any one of the .prompt files are changed) {
      create_e2e_check_list_items()
    }

    let code_check_items = (get list of items from ./code_check_items.txt)
    if any one of the item in {code_check_items} does not pass, return false, if they all passed, return true 

    let e2e_check_items = (get list of items from ./e2e_check_items.txt)
    if any one of the item in {e2e_check_items} does not pass, return false, if they all passed, return true 

  }
}
