task.sticky_popup {
  after highlighting a term or clicked on the rendered term, in the popup, do not auto-scroll as we stream the response, instead, show me the top part the message while the entire message is being streamed
  status: "completed"
}

task.fixed_popup_height {
  in task.sticky_popup {
    as we load the streaming message, the height of the popup is dynamically changing
    instead of doing that, we should have a fixed popup height in the very beginning, 400px
    status: "completed"
  }
}

task.draggable_popup {
  in task.fixed_popup_height {
    make the popup draggable
    remember the latest location of the popup so next time when we click on the highlighted term, the popup will show up at the last knowned location
  }
  status: "completed"
}

