  in ./a1_to_a8_terms_knowledge_graph {
    when click on each term, in the modal popup, make the title, content body font bigger, connected to section, all in same font size
  }
  status: "completed"
}

task {
  in ./a1_to_a8_terms_knowledge_graph {
    for each term, also include a small picture showing me how it looks like
  }
  status: "completed"
