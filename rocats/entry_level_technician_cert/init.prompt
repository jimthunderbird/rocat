    make the font of each term bigger so that i can see clearly
  }
  status: "completed"
}

task {
  in ./a1_to_a8_terms_knowledge_graph {
    do not make it like a tag-cloud style, make it like an engineering diagram to show the relationship among each term
  }
  status: "completed"
}

