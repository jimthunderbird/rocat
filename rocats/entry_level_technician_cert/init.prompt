    on page load, for each section (A1 to A8, make the title font same as the term, so that it is larger and clear)
  }
  status: "completed"
}

task {
  in ./entry_level_tech_rpg {
    make a single page app for a rpg game {
      main_character: an entry level technician certification learner
      game_play {
        show a map with all types of questions coming from ase_study_guides A1 to A8, covering all aspects of ase_study_guides
        when the main main_character move across the map, he will hit a question, once hit, show a modal {
          show the question
          below there is a "answer" button {
            @click {
              show the anser
            }
          }
        }
      }
    }
  }
  status: "completed"
}

task {
  in ./entry_level_tech_rpg {
    for A1 to A8, add 30 questions per section
  }
  status: "completed"
}

task {
  in ./entry_level_tech_rpg {
    for A1 to A8, add 40 questions per section
    for each question popup {
      even if I answered it correctly, still keep it in the map so that I can review it later
      i should be able to close the popup even without answering it
    }
  }
  status: "completed"
}

task {
  please use "https://freeasestudyguides.com/" as resource, also use ase_study_guides.source, create a single page html/javascript/css app in ./ase_study_qa {
    spec {
      data {
        from A1 to A8, and G1, each section should have 100 questions covering all related topics in ase_study_guides.source
      }
      user_interface {
        top_navigation_tabs: A1 to A8, G1, total 9 tabs
        for each tab in top_navigation_tabs {
          tab.@click {
            show a random question and 4 possible answers to choose
            under the answers, it should have a "Answer" button {
              @click {
                show the correct answer with a 50-60 words explanation, ideally with a diagram as well to help me understand it better           
              }
            }
          }
        }
      }
    }
  }
  status: "completed"
}

