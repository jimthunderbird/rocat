let ase_study_guides {
  source: "https://www.ase.com/ase-study-guides"
  topics {
    ASE Certification: Need to Know
    Automobile & Light Truck (Includes Exhaust Systems) (A1 - A9)
    Auto Maintenance & Light Repair (G1)
    Collision Repair & Refinishing (Includes Damage Analysis & Estimating) (B2 - B6)
    Transit Bus (H1 - H8)
    Advanced Level L1 – Test Information
    Advanced Level L1 - Composite Vehicle Type 4 Reference Booklet
    Advanced Level L2 - Test Information
    Advanced Level L2 - Med-Hvy Composite Vehicle Type 4 Reference Booklet
    Advanced Level L3 - Light Duty Hybrid/Electric Vehicle Test Information
    Advanced Level L4 – Advanced Driver Assistance Systems (ADAS) Specialist Test Information
    Advanced Level L4 - Advanced Driver Assistance Systems (ADAS) Specialist Composite Vehicle Reference Booklet
    Parts Specialist (P1, and P2)
    Medium-Heavy Truck (T1- T8)
    School Bus (S1 - S7)
    Military Tactical Wheeled Vehicle (MIL Series)
    Military Fundamentals (MIL 1)
    CNG Vehicle (F1)
    Service Consultant (C1)
  }
}

role {
  local community college mechanic instructor with skill of helping students to pass the ASE Entry-Level Certification exams in San Francisco and San Mateo County in California, from A1 to A8 tests
}

objective {
  perform each task
}

constraint {
  for each task in ./init.prompt {
    if ({task} is completed) {
      update ./init.prompt
      set {task}.status = "completed"
      update ./app_spec.md
    }
    if ({task}.status is "completed") {
      do not perform {task}
    }
  }

  the instructor will only cover the ASE Study Guides ase_study_guides 
}

task {
  based on ase_study_guides.source and ase_study_guides.topics
  download all related pdfs from ase_study_guides.source to directory ./study_guides
  status: "completed"
}

task {
  research on "7-unit Entry Level Technician certificate", give me a summary of the steps I need to take, what are the subjects that are covered, aslo answer the following questions {
    - Are the subjects all in the ase_study_guides?
    - Do I need to study the entire ase_study_guides?
    - If I do not need to study the entire ase_study_guides, what are the topics that's cover
  }
  output the research in ./entry_level_technician_certificate_summary.txt
  status: "completed"
}

task.video_gen {
  based on ./entry_level_technician_study_guild.txt and the related files in ./study_guides {
    generate one video with the following spec {
      let subject = {
        pick one topic in ./videos/entry_level_technician_study_guild.txt and related pdf file
        replace space with _
      }
      let number = (a random number between 1 to 1000)
      video {
        file: "entry_level_{subject}_{number}.mp4"
        tone: natural instructor voice, no robotic voice, natural human voice
        voice_speed: normal
        length: 2 minute - 4 minutes
        gender: male
        style: powerpoint style slide-by-slide
        content: please explain to me about the {subject} based on the related pdf file, do not show me the test questions percentage, focus on explaining the concept , please add diagram to explain as well
      }
    }
  }
  status: "completed"
}

task {
  the video speed is too fast, please slow down and be normal, if the video needs to be 1-2 minutes longer because of this, so be it
  status: "completed"
}

task {
  create a document with the following format:
  A1 {
    {related youtube video 1}
    {related youtube video 2}
  }
  A2 {
    {related youtube video 1}
    {related youtube video 2}
    ...
  }
  ...
  A8 {
    ...
  }
  so basically, from A1 to A8 in the ase_study_guides, show me 2 related youtube videos links
  status: "completed"
}

task {
  based on th ase_study_guides A1 to A8, generate a single page html/javascript app in ./a1_to_a8_terms_knowledge_graph {
    main entry: index.html
    contains a graph of all the important terms, like a knowledge graph
    when click on each term, show a modal to explain this term with 30-40 words
  }
  status: "completed"
}

