context: ./skill/spa_composer.prompt

app_spec {
  route: / {
    class Layout extends BaseLayout {
      BookInput {
        textbox {
          label: "Book Url"
        }
      }

      PopupShowHighlightedWords(words) {
        type: Popup Modal

        visible: false

        behavior {
          remember last position
          draggable
        }

        content: call LanguageService.translate(words)
      }

      BookContent {
        let paragraph = (split {content} by new line)
        paragraph.words.@highlighted {
          PopupShowHighlightedWords(highlighted words).visible = true
        }
      }
    }
  }
}
